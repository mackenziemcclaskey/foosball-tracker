# Copy to .env.local (or export directly) for local development.
# MongoDB Atlas connection string (free M0 cluster) — see README for setup.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: database name within the cluster (defaults to "foosball").
MONGODB_DB_NAME=foosball

# Optional: local port (Render sets this automatically in production).
PORT=4242
